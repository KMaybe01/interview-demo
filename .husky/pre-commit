if git diff --cached --name-only | grep -q 'package\.json$'; then
  echo "package.json changes detected, running bun install..."
  bun install
  bun prune
  git add bun.lock
fi

ROOT="$(git rev-parse --show-toplevel)"

# Go 后端质量门禁
(cd "$ROOT/apps/backend" && go vet ./... && go build -o /dev/null ./...)

# 仅对暂存文件做 lint + format（oxlint + oxfmt；规则见根 oxlint.config.mts / 格式化见 .oxfmtrc.json）
bunx lint-staged

# 全量测试与类型检查
bun run test
bun run typecheck
