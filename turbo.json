{
  "$schema": "https://v2-10-3.turborepo.dev/schema.json",
  "globalEnv": ["NODE_ENV"],
  "globalDependencies": [".env*"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".tsbuildinfo/**"],
      "inputs": ["$TURBO_DEFAULT$", "!dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "format": {
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    }
  }
}
