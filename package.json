{
  "name": "interview-demo-monorepo",
  "private": true,
  "version": "3.4.0",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky",
    "changelog": "conventional-changelog -n changelog.config.mjs -i CHANGELOG.md -s -r 0",
    "docs:check": "bun scripts/check-docs-links.mjs",
    "dev": "turbo run dev",
    "preview": "turbo run preview",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "typecheck": "turbo run typecheck",
    "analyze": "ANALYZE=true turbo run build",
    "analyze:frontend": "ANALYZE=true turbo run build --filter=@interview-demo/frontend",
    "analyze:ai-demo": "ANALYZE=true turbo run build --filter=@interview-demo/ai-demo",
    "analyze:interview-docs": "ANALYZE=true turbo run build --filter=@interview-demo/interview-docs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "conventional-changelog": "^8.0.1",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "husky": "^9.1.7",
    "turbo": "^2.10.13"
  }
}