{
  "name": "interview-demo-monorepo",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "bun run build && changeset publish",
    "changelog": "conventional-changelog -p conventionalcommits -i CHANGELOG.md -s",
    "dev": "turbo run dev --filter=!@interview-demo/backend-nest",
    "preview": "turbo run preview",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "typecheck": "turbo run typecheck",
    "analyze": "ANALYZE=true turbo run build",
    "analyze:frontend": "ANALYZE=true turbo run build --filter=@interview-demo/frontend",
    "analyze:ai-demo": "ANALYZE=true turbo run build --filter=@interview-demo/ai-demo",
    "analyze:interview-docs": "ANALYZE=true turbo run build --filter=@interview-demo/interview-docs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "conventional-changelog": "^8.0.0",
    "conventional-changelog-conventionalcommits": "^10.2.0",
    "husky": "^9.1.7",
    "turbo": "^2.10.4"
  }
}
