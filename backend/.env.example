# OpenAI Configuration
OPENAI_API_KEY=sk-your-api-key-here

# Optional: Custom API endpoint (for proxy or compatible APIs)
# OPENAI_BASE_URL=https://api.openai.com

# DeepSeek API Key (optional)
# DEEPSEEK_API_KEY=sk-your-deepseek-key

# Ollama local service URL (optional)
# OLLAMA_BASE_URL=http://localhost:11434

# Server port
PORT=8080

# CORS allowed origin
CORS_ORIGIN=*

# Doc directory for knowledge base auto-loading
# DOCS_DIR=../docs

# Log level: debug, info, warn, error
# LOG_LEVEL=info

# Embedding model: openai, bge, local
# EMBEDDING_MODEL=openai
# EMBEDDING_DIMENSIONS=1536

# Chunk strategy: recursive, token, markdown, fixed
# CHUNK_STRATEGY=recursive
# CHUNK_SIZE=512
# CHUNK_OVERLAP=50
